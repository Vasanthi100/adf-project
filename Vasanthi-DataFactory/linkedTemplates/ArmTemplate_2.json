			"type": "Microsoft.DataFactory/factories/dataflows",
			"apiVersion": "2018-06-01",
			"properties": {
				"type": "MappingDataFlow",
				"typeProperties": {
					"sources": [
						{
							"dataset": {
								"referenceName": "11_DS_scd_source",
								"type": "DatasetReference"
							},
							"name": "scdsource"
						}
					],
					"sinks": [
						{
							"dataset": {
								"referenceName": "scd_dest",
								"type": "DatasetReference"
							},
							"name": "sinkscd"
						}
					],
					"transformations": [
						{
							"name": "alterRow1"
						}
					],
					"scriptLines": [
						"source(output(",
						"          Employee_ID as integer,",
						"          First_Name as string,",
						"          Salary as decimal(10,2),",
						"          Location as string",
						"     ),",
						"     allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     ignoreNoFilesFound: false) ~> scdsource",
						"scdsource alterRow(upsertIf(true())) ~> alterRow1",
						"alterRow1 sink(allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     input(",
						"          Employee_ID as integer,",
						"          First_Name as string,",
						"          Salary as integer,",
						"          Location as string",
						"     ),",
						"     deletable:false,",
						"     insertable:true,",
						"     updateable:false,",
						"     upsertable:true,",
						"     keys:['Employee_ID'],",
						"     format: 'table',",
						"     skipDuplicateMapInputs: true,",
						"     skipDuplicateMapOutputs: true,",
						"     errorHandlingOption: 'stopOnFirstError',",
						"     mapColumn(",
						"          Employee_ID,",
						"          First_Name,",
						"          Salary,",
						"          Location",
						"     )) ~> sinkscd"
					]
				}
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/datasets/scd_dest')]"
			]
		},
		{
			"name": "[concat(parameters('factoryName'), '/12_scd2_dataflow')]",
			"type": "Microsoft.DataFactory/factories/dataflows",
			"apiVersion": "2018-06-01",
			"properties": {
				"type": "MappingDataFlow",
				"typeProperties": {
					"sources": [
						{
							"dataset": {
								"referenceName": "DS_DataLake_Source",
								"type": "DatasetReference"
							},
							"name": "datalakesource"
						},
						{
							"dataset": {
								"referenceName": "DS_AzureSQLDB_Source",
								"type": "DatasetReference"
							},
							"name": "ADBSource"
						}
					],
					"sinks": [
						{
							"dataset": {
								"referenceName": "DS_InsertDB",
								"type": "DatasetReference"
							},
							"name": "InsertSink"
						},
						{
							"dataset": {
								"referenceName": "DS_UpdateSink",
								"type": "DatasetReference"
							},
							"name": "UPDATESink"
						}
					],
					"transformations": [
						{
							"name": "SrcderivedColumnHashCode"
						},
						{
							"name": "DestDerivedColumnHC",
							"description": "Creating/updating the columns 'Emp_ID, FName, Salary, Loc'"
						},
						{
							"name": "SRCexistsHC"
						},
						{
							"name": "IsActiveDerivedColumn"
						},
						{
							"name": "InsertSelect"
						},
						{
							"name": "EmpIDExists"
						},
						{
							"name": "DestexistsHC"
						},
						{
							"name": "IsActiveDestDerivedColumn"
						},
						{
							"name": "UpdateAlterRow"
						},
						{
							"name": "UPDATESelect"
						}
					],
					"scriptLines": [
						"source(output(",
						"          Employee_ID as integer,",
						"          First_Name as string,",
						"          Salary as integer,",
						"          Location as string",
						"     ),",
						"     allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     ignoreNoFilesFound: false,",
						"     partitionBy('hash', 1)) ~> datalakesource",
						"source(output(",
						"          SurrKey as integer,",
						"          Emp_ID as integer,",
						"          FName as string,",
						"          Salary as integer,",
						"          Loc as string,",
						"          Is_Active as boolean",
						"     ),",
						"     allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     isolationLevel: 'READ_UNCOMMITTED',",
						"     format: 'table',",
						"     partitionBy('hash', 1)) ~> ADBSource",
						"datalakesource derive({Hash Code} = md5(Employee_ID,First_Name,Salary,Location),",
						"     partitionBy('hash', 1)) ~> SrcderivedColumnHashCode",
						"ADBSource derive({Hash Code} = md5(Emp_ID,FName,Salary,Loc),",
						"     partitionBy('hash', 1)) ~> DestDerivedColumnHC",
						"SrcderivedColumnHashCode, DestDerivedColumnHC exists(SrcderivedColumnHashCode@{Hash Code} == DestDerivedColumnHC@{Hash Code},",
						"     negate:true,",
						"     partitionBy('hash', 1),",
						"     broadcast: 'auto')~> SRCexistsHC",
						"SRCexistsHC derive(Is_Active = 1,",
						"     partitionBy('hash', 1)) ~> IsActiveDerivedColumn",
						"IsActiveDerivedColumn select(mapColumn(",
						"          Employee_ID,",
						"          First_Name,",
						"          Salary,",
						"          Location,",
						"          Is_Active",
						"     ),",
						"     partitionBy('hash', 1),",
						"     skipDuplicateMapInputs: true,",
						"     skipDuplicateMapOutputs: true) ~> InsertSelect",
						"DestDerivedColumnHC, datalakesource exists(Emp_ID == Employee_ID,",
						"     negate:false,",
						"     partitionBy('hash', 1),",
						"     broadcast: 'auto')~> EmpIDExists",
						"EmpIDExists, SrcderivedColumnHashCode exists(DestDerivedColumnHC@{Hash Code} == SrcderivedColumnHashCode@{Hash Code},",
						"     negate:true,",
						"     partitionBy('hash', 1),",
						"     broadcast: 'auto')~> DestexistsHC",
						"DestexistsHC derive(Is_Active = 0,",
						"     partitionBy('hash', 1)) ~> IsActiveDestDerivedColumn",
						"IsActiveDestDerivedColumn alterRow(updateIf(true()),",
						"     partitionBy('hash', 1)) ~> UpdateAlterRow",
						"UpdateAlterRow select(mapColumn(",
						"          SurrKey,",
						"          Emp_ID,",
						"          FName,",
						"          Salary,",
						"          Loc,",
						"          Is_Active",
						"     ),",
						"     partitionBy('hash', 1),",
						"     skipDuplicateMapInputs: true,",
						"     skipDuplicateMapOutputs: true) ~> UPDATESelect",
						"InsertSelect sink(allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     input(",
						"          SurrKey as integer,",
						"          Emp_ID as integer,",
						"          FName as string,",
						"          Salary as integer,",
						"          Loc as string,",
						"          Is_Active as boolean",
						"     ),",
						"     deletable:false,",
						"     insertable:true,",
						"     updateable:false,",
						"     upsertable:false,",
						"     format: 'table',",
						"     skipDuplicateMapInputs: true,",
						"     skipDuplicateMapOutputs: true,",
						"     errorHandlingOption: 'stopOnFirstError',",
						"     mapColumn(",
						"          Emp_ID = Employee_ID,",
						"          FName = First_Name,",
						"          Salary,",
						"          Loc = Location,",
						"          Is_Active",
						"     ),",
						"     partitionBy('hash', 1)) ~> InsertSink",
						"UPDATESelect sink(allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     input(",
						"          SurrKey as integer,",
						"          Emp_ID as integer,",
						"          FName as string,",
						"          Salary as integer,",
						"          Loc as string,",
						"          Is_Active as boolean",
						"     ),",
						"     deletable:false,",
						"     insertable:false,",
						"     updateable:true,",
						"     upsertable:false,",
						"     keys:['SurrKey'],",
						"     format: 'table',",
						"     skipDuplicateMapInputs: true,",
						"     skipDuplicateMapOutputs: true,",
						"     errorHandlingOption: 'stopOnFirstError',",
						"     mapColumn(",
						"          SurrKey,",
						"          Emp_ID,",
						"          FName,",
						"          Salary,",
						"          Loc,",
						"          Is_Active",
						"     ),",
						"     partitionBy('hash', 1)) ~> UPDATESink"
					]
				}
			},
			"dependsOn": []
		},
		{
			"name": "[concat(parameters('factoryName'), '/3_Dataflow_S3')]",
			"type": "Microsoft.DataFactory/factories/dataflows",
			"apiVersion": "2018-06-01",
			"properties": {
				"type": "MappingDataFlow",
				"typeProperties": {
					"sources": [
						{
							"dataset": {
								"referenceName": "6_DS_DF_txtfile",
								"type": "DatasetReference"
							},
							"name": "SourceS3File"
						}
					],
					"sinks": [
						{
							"dataset": {
								"referenceName": "6_DS_DL_Transform",
								"type": "DatasetReference"
							},
							"name": "sink1"
						}
					],
					"transformations": [
						{
							"name": "PivotData"
						}
					],
					"scriptLines": [
						"source(output(",
						"          ID as short,",
						"          Product as string,",
						"          Sales as integer",
						"     ),",
						"     allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     ignoreNoFilesFound: false) ~> SourceS3File",
						"SourceS3File pivot(groupBy(ID),",
						"     pivotBy(Product),",
						"     Total_Amt_Purchased_ = sum(Sales),",
						"     columnNaming: '$N$V',",
						"     lateral: true) ~> PivotData",
						"PivotData sink(allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     umask: 0022,",
						"     preCommands: [],",
						"     postCommands: [],",
						"     skipDuplicateMapInputs: true,",
						"     skipDuplicateMapOutputs: true) ~> sink1"
					]
				}
			},
			"dependsOn": []
		},
		{
			"name": "[concat(parameters('factoryName'), '/3_TransformData')]",
			"type": "Microsoft.DataFactory/factories/dataflows",
			"apiVersion": "2018-06-01",
			"properties": {
				"type": "MappingDataFlow",
				"typeProperties": {
					"sources": [
						{
							"dataset": {
								"referenceName": "3_source_salesfiles_prop",
								"type": "DatasetReference"
							},
							"name": "SourceSalesFiles3"
						}
					],
					"sinks": [
						{
							"dataset": {
								"referenceName": "3_target_business_prop",
								"type": "DatasetReference"
							},
							"name": "sinkReporting3"
						}
					],
					"transformations": [
						{
							"name": "wherefilter3"
						},
						{
							"name": "selectCols3"
						},
						{
							"name": "countrysplit"
						},
						{
							"name": "LineSalesAmount"
						},
						{
							"name": "aggregation3"
						}
					],
					"scriptLines": [
						"source(output(",
						"          InvoiceNo as integer,",
						"          StockCode as integer,",
						"          Description as string,",
						"          Quantity as integer,",
						"          InvoiceDate as timestamp,",
						"          UnitPrice as double,",
						"          CustomerID as integer,",
						"          Country as string",
						"     ),",
						"     allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     ignoreNoFilesFound: false) ~> SourceSalesFiles3",
						"SourceSalesFiles3 filter(InvoiceNo!=537669) ~> wherefilter3",
						"wherefilter3 select(mapColumn(",
						"          InvoiceNo,",
						"          Quantity,",
						"          InvoiceDate,",
						"          UnitPrice,",
						"          CustomerID,",
						"          Country",
						"     ),",
						"     skipDuplicateMapInputs: true,",
						"     skipDuplicateMapOutputs: true) ~> selectCols3",
						"selectCols3 split(Country == \"United Kingdom\",",
						"     Country == \"Germany\",",
						"     disjoint: false) ~> countrysplit@(UK, Germany, Others)",
						"countrysplit@UK derive(LineSalesAmount = Quantity*UnitPrice) ~> LineSalesAmount",
						"LineSalesAmount aggregate(groupBy(InvoiceNo),",
						"     TotalSales = sum(LineSalesAmount)) ~> aggregation3",
						"aggregation3 sink(allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     umask: 0022,",
						"     preCommands: [],",
						"     postCommands: [],",
						"     skipDuplicateMapInputs: true,",
						"     skipDuplicateMapOutputs: true) ~> sinkReporting3"
					]
				}
			},
			"dependsOn": []
		},
		{
			"name": "[concat(parameters('factoryName'), '/dataflowjoins')]",
			"type": "Microsoft.DataFactory/factories/dataflows",
			"apiVersion": "2018-06-01",
			"properties": {
				"type": "MappingDataFlow",
				"typeProperties": {
					"sources": [
						{
							"dataset": {
								"referenceName": "DS_Customers",
								"type": "DatasetReference"
							},
							"name": "sourcecustomers"
						},
						{
							"dataset": {
								"referenceName": "DS_Orders",
								"type": "DatasetReference"
							},
							"name": "sourceorders"
						}
					],
					"sinks": [
						{
							"dataset": {
								"referenceName": "DS_JoinsOutput",
								"type": "DatasetReference"
							},
							"name": "sinkfile"
						}
					],
					"transformations": [
						{
							"name": "joincustomersorders"
						},
						{
							"name": "selectcustord"
						}
					],
					"scriptLines": [
						"source(output(",
						"          Customer_ID as short,",
						"          Name as string,",
						"          Email as string",
						"     ),",
						"     allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     ignoreNoFilesFound: false) ~> sourcecustomers",
						"source(output(",
						"          Order_ID as short,",
						"          Cust_ID as short,",
						"          Price as short",
						"     ),",
						"     allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     ignoreNoFilesFound: false) ~> sourceorders",
						"sourcecustomers, sourceorders join(Customer_ID == Cust_ID,",
						"     joinType:'outer',",
						"     matchType:'exact',",
						"     ignoreSpaces: false,",
						"     partitionBy('hash', 1),",
						"     broadcast: 'auto')~> joincustomersorders",
						"joincustomersorders select(mapColumn(",
						"          Customer_ID,",
						"          Name,",
						"          Email,",
						"          Order_ID,",
						"          Price",
						"     ),",
						"     partitionBy('hash', 1),",
						"     skipDuplicateMapInputs: true,",
						"     skipDuplicateMapOutputs: true) ~> selectcustord",
						"selectcustord sink(allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     umask: 0022,",
						"     preCommands: [],",
						"     postCommands: [],",
						"     skipDuplicateMapInputs: true,",
						"     skipDuplicateMapOutputs: true,",
						"     mapColumn(",
						"          Customer_ID,",
						"          Name,",
						"          Email,",
						"          Order_ID,",
						"          Price",
						"     ),",
						"     partitionBy('hash', 1)) ~> sinkfile"
					]
				}
			},
			"dependsOn": []
		},
